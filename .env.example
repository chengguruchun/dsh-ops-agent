# GitLab
OPS_GITLAB_URL=https://gitlab.example.com
OPS_GITLAB_TOKEN=
OPS_GITLAB_PROJECT=group/project

# Kubernetes
OPS_KUBECONFIG=
OPS_KUBE_CONTEXT=

# Docker registry (password never logged)
OPS_DOCKER_REGISTRY=registry.example.com
OPS_DOCKER_NAMESPACE=myteam
OPS_DOCKER_USERNAME=
OPS_DOCKER_PASSWORD=

# Logs: kubectl | loki | http
OPS_LOG_PROVIDER=kubectl
OPS_LOKI_URL=http://loki.example.com:3100
OPS_LOG_HTTP_URL=http://logs.example.com/query

# Metrics (optional)
OPS_METRICS_HTTP_URL=http://metrics.example.com/query

# Release: http | script
OPS_RELEASE_PROVIDER=http
OPS_RELEASE_WEBHOOK_URL=https://release.example.com/hooks/deploy
OPS_RELEASE_SCRIPT=/usr/local/bin/ops-release

# Optional self-review shell (lint/test); non-zero exit = release blocker
# OPS_REVIEW_COMMAND=npm test

# ── Code review sibling domain (@dsh-ops-agent/code-review) ──
# CR_PROVIDER=github
# CR_REPO=owner/repo
# GH_TOKEN=
# # or CR_GH_TOKEN=
# GITLAB_TOKEN=
# # or CR_GITLAB_TOKEN=
# CR_GITLAB_URL=https://gitlab.example.com
# CR_REVIEW_COMMAND=npm test
# CR_STATIC_CHECKS=true
# CR_PUBLISH=false
# CR_HUGE_DIFF_LINES=800
# CR_TODO_DENSITY=5
# CR_CHECKPOINT_DIR=.cr-checkpoints

# ── V0.2 Risk Gate ──
# L0 auto | L1 auto+verify | L2 review | L3 approval | L4 human-only
# OPS_RISK_APPROVED=1          # unlock L3 (approval) for mutating release / helm / kubectl apply
# OPS_RISK_L3_UNLOCK=1         # alias of OPS_RISK_APPROVED
# OPS_RISK_HUMAN_UNLOCK=1      # break-glass for L4 (still prefer explicit approval in code)
